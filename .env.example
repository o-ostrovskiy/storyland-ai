# Google AI API Key
GOOGLE_API_KEY=your-google-ai-api-key-here

# Database Configuration
USE_DATABASE=false
DATABASE_URL=sqlite+aiosqlite:///storyland_sessions.db

# Session Configuration
SESSION_MAX_EVENTS=20

# Context Management
MAX_CONTEXT_TOKENS=30000

# Model Configuration
MODEL_NAME=gemini-2.5-flash-lite

# Workflow Execution
WORKFLOW_TIMEOUT=300
AGENT_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
ENABLE_ADK_DEBUG=false

# Langfuse Configuration
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Analytics / Telemetry
# Server-side core-funnel telemetry (search_submitted/result_shown/search_empty/search_failed).
# Off by default; additive logging seam that complements frontend GA4.
ANALYTICS_ENABLED=false
