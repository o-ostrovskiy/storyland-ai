# Google AI API Key
GOOGLE_API_KEY=your-google-ai-api-key-here

# Database Configuration
USE_DATABASE=false
DATABASE_URL=sqlite+aiosqlite:///storyland_sessions.db

# Session Configuration
SESSION_MAX_EVENTS=20

# Context Management
MAX_CONTEXT_TOKENS=30000

# Model Configuration
MODEL_NAME=gemini-2.5-flash-lite

# Workflow Execution
WORKFLOW_TIMEOUT=300
AGENT_TIMEOUT=60

# Gemini retry backoff (bounded so worst-case retries finish well under
# WORKFLOW_TIMEOUT). exp_base=2 + max_delay keeps the schedule interactive;
# the previous exp_base=7 could blow the timeout budget under throttling.
RETRY_EXP_BASE=2
RETRY_MAX_DELAY=12
RETRY_ATTEMPTS=4

# Book-recommendation floor: minimum recommendations the tool-less formatter
# may return (3-5). Lowered from a hard 5 so a thin grounded researcher result
# is never padded with an invented book. Clamped to 1..5.
REC_MIN_RESULTS=3

# Logging
LOG_LEVEL=INFO
ENABLE_ADK_DEBUG=false

# Langfuse Configuration
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Result Cache (in-process; caches the Discovery book->regions chain)
# Always on. Tune the TTL / max entries below.
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=500
