   "versionNonce": 816223384,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795320000000,
   "link": null,
   "locked": false,
   "text": "1  Two requests: discover, then compose\n2  Cache hit: regions come back, no model call\n3  Cache miss: the discovery graph runs",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1  Two requests: discover, then compose\n2  Cache hit: regions come back, no model call\n3  Cache miss: the discovery graph runs",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "legend_1",
   "type": "text",
   "x": 425,
   "y": 566,
   "width": 390.0,
   "height": 56.2,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 393228213,
   "version": 1,
   "versionNonce": 2071126974,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795320000000,
   "link": null,
   "locked": false,
   "text": "4  Every agent calls Gemini; researchers can search\n5  Research, and who searched, goes to session state\n6  Compose: trip_composer plans the chosen regions",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4  Every agent calls Gemini; researchers can search\n5  Research, and who searched, goes to session state\n6  Compose: trip_composer plans the chosen regions",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "legend_2",
