   "isDeleted": false,
   "boundElements": null,
   "updated": 1795320000000,
   "link": null,
   "locked": false,
   "text": "7  literal and historical labels checked against 5\n8  SSE events back: regions, then itinerary",
   "fontSize": 15,
   "fontFamily": 2,
